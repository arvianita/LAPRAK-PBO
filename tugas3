package kls;

import java.io.*;

public class kls5 {
    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));

        System.out.print("Jumlah mangga dibeli (pcs)        : ");
        int mangga = Integer.parseInt(br.readLine());
        System.out.print("Jumlah tetangga                   : ");
        int tetangga = Integer.parseInt(br.readLine());
        System.out.print("Jambu per tetangga (pcs)          : ");
        int jambuPerOrang = Integer.parseInt(br.readLine());
        System.out.print("Mangga busuk dikembalikan (pcs)   : ");
        int busuk = Integer.parseInt(br.readLine());

        int jambu = tetangga * jambuPerOrang;
        int mangaBersih = mangga - busuk;
        int total = mangaBersih + jambu;

        System.out.println("\nMangga dibeli (setelah retur) : " + mangaBersih + " pcs");
        System.out.println("Jambu dibeli                  : " + jambu + " pcs");
        System.out.println("Total buah yang dibeli        : " + total + " pcs");
    }
}


    



package kls;

 import java.util.Scanner;
public class kls6 {
   
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        System.out.println("WAKTU PERTAMA");
        System.out.print("Jam: ");
        long jam1 = input.nextInt();
        System.out.print("Menit: ");
        long menit1 = input.nextInt();
        System.out.print("Detik: ");
        long detik1 = input.nextInt();

        System.out.println("WAKTU KEDUA");
        System.out.print("Jam: ");
        long jam2 = input.nextInt();
        System.out.print("Menit: ");
        long menit2 = input.nextInt();
        System.out.print("Detik: ");
        long detik2 = input.nextInt();

        long waktu1 = jam1 * 3600 + menit1 * 60 + detik1;
        long waktu2 = jam2 * 3600 + menit2 * 60 + detik2;

        long selisih = Math.abs(waktu2 - waktu1);

        long jam = selisih / 3600;
        long menit = (selisih % 3600) / 60;
        long detik = selisih % 60;

        System.out.println("Selisih waktu: " + jam + " jam "
                           + menit + " menit " + detik + " detik");

        input.close();
    }
}



package kls;

import java.util.Scanner;
public class kls7 {
     
    static String format(long totalDetik) {
        long hari  = totalDetik / 86400;
        long sisa  = totalDetik % 86400;
        long jam   = sisa / 3600;
        sisa       = sisa % 3600;
        long menit = sisa / 60;
        long detik = sisa % 60;
        return hari + " hari, " + jam + " jam, " + menit + " menit, " + detik + " detik";
    }

    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);

        // Mesin cetak: 1 lembar/detik
        System.out.println("=== Pencetakan Novel Pertama ===");
        System.out.print("Jumlah novel   : ");
        long novel1 = in.nextLong();
        System.out.print("Tebal (lembar) : ");
        long lembar1 = in.nextLong();

        System.out.println("\n=== Pencetakan Novel Kedua ===");
        System.out.print("Jumlah novel   : ");
        long novel2 = in.nextLong();
        System.out.print("Tebal (lembar) : ");
        long lembar2 = in.nextLong();

        long waktu1 = novel1 * lembar1;   // detik
        long waktu2 = novel2 * lembar2;   // detik
        long selisih = Math.abs(waktu1 - waktu2);

        System.out.println("\nWaktu pertama : " + format(waktu1));
        System.out.println("Waktu kedua   : " + format(waktu2));
        System.out.println("Selisih waktu : " + format(selisih));
    }
}

